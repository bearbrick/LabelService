# ---------------------------------------------------------------
# 编译输出（backend/、client/ 的 .NET 项目）
# ---------------------------------------------------------------
bin/
obj/
publish/
artifacts/
TestResults/
BenchmarkDotNet.Artifacts/
*.nupkg
*.snupkg

# Visual Studio、Rider、VS Code 的个人设置
.vs/
.idea/
*.user
*.suo
*.DotSettings.user
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------
# 前端（frontend/）：依赖和打包输出
# ---------------------------------------------------------------
node_modules/
dist/
coverage/
*.local
*.tsbuildinfo
npm-debug.log*

# ---------------------------------------------------------------
# 运行时数据：SQLite 库、备份、日志（ADR 0003）
# ---------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
backup/
# 运行日志限定为仓库或组件运行目录，避免忽略 Domain/Logs、Application/Logs 等源码目录。
/logs/
/backend/logs/
/client/logs/
/frontend/logs/
*.log

# ---------------------------------------------------------------
# 本地配置与密钥：不进仓库
# ---------------------------------------------------------------
appsettings.*.local.json
.env
.env.*
!.env.example
*.pfx
*.p12
*.snk
*.key
# 管理后台 JWT 签名密钥（没配置时生成在数据目录里）
admin-signing.key

# AI 助手的个人设置（共享规则写在 AGENTS.md）
.claude/settings.local.json
CLAUDE.local.md

# 按 README 快速开始在仓库根目录生成的标签文件
/*.png
/*.pdf
/*.zpl

# 系统文件
Thumbs.db
.DS_Store

# ---------------------------------------------------------------
# 字体文件：几十 MB，存放方式（Git LFS 或下载脚本）待定，见 backend/assets/fonts/README.md
# ---------------------------------------------------------------
backend/assets/fonts/*.otf
backend/assets/fonts/*.ttf
backend/assets/fonts/*.ttc
backend/assets/fonts/*.otc
