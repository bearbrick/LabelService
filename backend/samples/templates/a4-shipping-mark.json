{
  "schemaVersion": "1.0",
  "code": "A4_SHIPPING_MARK",
  "name": "出口唛头 A4",
  "page": { "width": 210, "height": 297, "dpi": 300 },
  "fields": [
    { "key": "consignee", "name": "收货人唛", "type": "string", "required": true, "sample": "ACME TRADING" },
    { "key": "destination", "name": "目的港", "type": "string", "required": true, "sample": "HAMBURG, GERMANY" },
    { "key": "poNo", "name": "订单号", "type": "string", "required": true, "sample": "PO-2026-08817" },
    { "key": "itemNo", "name": "货号", "type": "string", "required": true, "sample": "PA-65W-EU" },
    { "key": "description", "name": "品名", "type": "string", "required": true, "sample": "65W USB-C 电源适配器 / 65W USB-C POWER ADAPTER, EU PLUG" },
    { "key": "qty", "name": "每箱数量", "type": "number", "required": true, "format": "0", "sample": 40 },
    { "key": "grossWeight", "name": "毛重 kg", "type": "number", "required": true, "format": "0.0", "sample": 18.6 },
    { "key": "netWeight", "name": "净重 kg", "type": "number", "required": true, "format": "0.0", "sample": 16.2 },
    { "key": "measurement", "name": "尺寸", "type": "string", "required": true, "sample": "60 × 40 × 35 CM" },
    { "key": "cartonNo", "name": "箱号", "type": "number", "required": true, "format": "0", "sample": 12 },
    { "key": "cartonTotal", "name": "总箱数", "type": "number", "required": true, "format": "0", "sample": 80 },
    { "key": "gtin", "name": "箱码 GTIN-14", "type": "string", "required": true, "sample": "16901234567899" }
  ],
  "elements": [
    { "id": "frame", "type": "rect", "name": "外框", "x": 8, "y": 8, "width": 194, "height": 281, "stroke": { "width": 1 } },
    { "id": "logo", "type": "image", "name": "Logo", "x": 16, "y": 16, "width": 54, "height": 18, "src": "asset:logo", "fit": "contain" },
    { "id": "title", "type": "text", "name": "标题", "x": 110, "y": 16, "width": 84, "height": 18,
      "content": "SHIPPING MARK\n唛头", "style": { "fontSize": 14, "bold": true, "align": "right", "lineHeight": 1.1 } },
    { "id": "rule1", "type": "line", "x": 16, "y": 40, "width": 178, "height": 0, "stroke": { "width": 0.6 } },
    { "id": "consignee", "type": "text", "name": "收货人唛", "x": 16, "y": 46, "width": 178, "height": 24,
      "content": "{{consignee}}", "style": { "fontSize": 40, "bold": true, "align": "center", "fit": "shrink", "minFontSize": 16 } },
    { "id": "destination", "type": "text", "name": "目的港", "x": 16, "y": 72, "width": 178, "height": 12,
      "content": "{{destination}}", "style": { "fontSize": 22, "align": "center", "fit": "shrink", "minFontSize": 10 } },
    { "id": "rule2", "type": "line", "x": 16, "y": 90, "width": 178, "height": 0, "stroke": { "width": 0.6 } },
    { "id": "po", "type": "text", "x": 16, "y": 96, "width": 89, "height": 10,
      "content": "PO NO.：{{poNo}}", "style": { "fontSize": 14, "fit": "shrink" } },
    { "id": "item", "type": "text", "x": 107, "y": 96, "width": 87, "height": 10,
      "content": "ITEM NO.：{{itemNo}}", "style": { "fontSize": 14, "fit": "shrink" } },
    { "id": "desc", "type": "text", "name": "品名", "x": 16, "y": 108, "width": 178, "height": 20,
      "content": "DESCRIPTION 品名：{{description}}", "style": { "fontSize": 13, "fit": "wrap", "vAlign": "top", "lineHeight": 1.25 } },
    { "id": "qty", "type": "text", "x": 16, "y": 132, "width": 89, "height": 10,
      "content": "QTY 数量：{{qty}} PCS", "style": { "fontSize": 14 } },
    { "id": "meas", "type": "text", "x": 107, "y": 132, "width": 87, "height": 10,
      "content": "MEAS 尺寸：{{measurement}}", "style": { "fontSize": 14, "fit": "shrink" } },
    { "id": "gw", "type": "text", "x": 16, "y": 144, "width": 89, "height": 10,
      "content": "G.W. 毛重：{{grossWeight}} KG", "style": { "fontSize": 14 } },
    { "id": "nw", "type": "text", "x": 107, "y": 144, "width": 87, "height": 10,
      "content": "N.W. 净重：{{netWeight}} KG", "style": { "fontSize": 14 } },
    { "id": "rule3", "type": "line", "x": 16, "y": 160, "width": 178, "height": 0, "stroke": { "width": 0.6 } },
    { "id": "carton", "type": "text", "name": "箱号", "x": 16, "y": 166, "width": 178, "height": 20,
      "content": "C/NO. {{cartonNo}} / {{cartonTotal}}", "style": { "fontSize": 32, "bold": true, "align": "center" } },
    { "id": "origin", "type": "text", "x": 16, "y": 188, "width": 178, "height": 10,
      "content": "MADE IN CHINA 中国制造", "style": { "fontSize": 16, "align": "center" } },
    { "id": "itf", "type": "barcode", "name": "箱码", "x": 16, "y": 210, "width": 120, "height": 40,
      "symbology": "itf14", "value": "{{gtin}}", "align": "left",
      "showText": true, "textPosition": "bottom", "textStyle": { "fontSize": 12 }, "quietZone": 6 },
    { "id": "qr", "type": "qrcode", "x": 150, "y": 206, "width": 44, "height": 44,
      "symbology": "qr", "value": "{{poNo}}|{{itemNo}}|{{cartonNo}}/{{cartonTotal}}", "ecLevel": "M" },
    { "id": "icon-up", "type": "icon", "x": 16, "y": 260, "width": 22, "height": 22, "icon": "gb191/up", "color": "#000000" },
    { "id": "icon-dry", "type": "icon", "x": 44, "y": 260, "width": 22, "height": 22, "icon": "gb191/keep-dry", "color": "#000000" },
    { "id": "icon-fragile", "type": "icon", "x": 72, "y": 260, "width": 22, "height": 22, "icon": "gb191/fragile", "color": "#000000" }
  ]
}
