<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 服务端：开放 API、管理 API、鉴权、模板存储、监控。渲染逻辑只在 Rendering 里写。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelService.Contracts\LabelService.Contracts.csproj" />
    <ProjectReference Include="..\LabelService.Rendering\LabelService.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkiaSharp 的 Linux 原生库，Docker 部署需要。Windows 原生库随 SkiaSharp 包自带。 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabelService.Backend.Checks" />
  </ItemGroup>

  <ItemGroup>
    <!-- 模板数据库：SQLite（ADR 0003）。Design 只在生成迁移时用，不随程序发布。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 字体：构建时从 backend/assets/fonts 复制到输出目录的 fonts/，服务启动时加载（T-001）。 -->
    <Content Include="..\..\assets\fonts\*.otf;..\..\assets\fonts\*.ttf;..\..\assets\fonts\*.ttc;..\..\assets\fonts\*.otc;..\..\assets\fonts\*.txt" LinkBase="fonts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 示例模板：开发环境首次建库时导入为已发布版本；模板来源配置为 Files 时直接从这里加载。 -->
    <Content Include="..\..\samples\templates\*.json" LinkBase="SeedTemplates" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
