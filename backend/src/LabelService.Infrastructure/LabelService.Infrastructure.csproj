<Project Sdk="Microsoft.NET.Sdk">

  <!-- 基础设施层：EF Core 和三种数据库、仓储实现、文件存储、密码哈希、登录令牌、后台任务（ADR 0010）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelService.Contracts\LabelService.Contracts.csproj" />
    <ProjectReference Include="..\LabelService.Rendering\LabelService.Rendering.csproj" />
    <ProjectReference Include="..\LabelService.Domain\LabelService.Domain.csproj" />
    <ProjectReference Include="..\LabelService.Application\LabelService.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 数据库：默认 SQLite（ADR 0003），可切换 SQL Server、PostgreSQL（ADR 0010）。Design 只在生成迁移时用，不随程序发布。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 管理后台的登录令牌（JWT，ADR 0006）；版本和接口层的 JwtBearer 依赖的一致。 -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabelService.Backend.Checks" />
  </ItemGroup>

</Project>
