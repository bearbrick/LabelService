<Project>

  <!-- 调用端全部项目共用。产品项目（src/）另有 src/Directory.Build.props 强制 XML 注释。后端（backend/）有自己的一份，互不影响。 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet 漏洞公告不阻断本地构建，但会以警告出现，需要及时处理。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Product>标签生成服务</Product>
    <!-- SDK 独立于后端发版：语义化版本，预览版带 -preview.N。正式发布时去掉 VersionSuffix，或由 client/build/pack.ps1 -Version 指定。 -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.3</VersionSuffix>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
