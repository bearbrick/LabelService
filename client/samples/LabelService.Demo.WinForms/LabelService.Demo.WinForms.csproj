<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK 调用演示程序：同一份代码编译 .NET Framework 4.8 和 .NET 10 两个版本。完整界面按 docs/prototypes 的原型实现（T-012）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LabelServiceDemo</AssemblyName>
    <RootNamespace>LabelService.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LabelService.Client\LabelService.Client.csproj" />
  </ItemGroup>

</Project>
